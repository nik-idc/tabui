{
  "compilerOptions": {
    "sourceMap": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "ts-node": {
    "esm": true
  },
  "include": ["src/**/*"]
}
