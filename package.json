{
  "name": "@atikincode/tabui",
  "version": "0.1.47",
  "description": "Framework-agnostic tablature editor library",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./assets/*": "./assets/*"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "/assets",
    "/dist/**/*.d.ts",
    "/dist/index.mjs",
    "/dist/index.mjs.map",
    "/dist/styles.css",
    "/dist/styles.mjs",
    "/dist/styles.mjs.map"
  ],
  "scripts": {
    "build": "vite build --config vite.config.lib.js && tsc --build",
    "benchmark:updates": "npx tsx scripts/benchmark-updates.ts",
    "verify": "npm test && npm run build && npm run test:pack-consumer && npm run build_vite",
    "clean": "rm -rf dist",
    "dev": "vite",
    "build_vite": "vite build",
    "preview_vite": "vite preview",
    "serve_vite": "npx vite",
    "test": "tsc --project tsconfig.test.json && npx jest",
    "test:pack-consumer": "node tests/package/pack-consumer-smoke.mjs",
    "prepare": "husky",
    "format": "npx prettier --write ."
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@types/jest": "^29.5.14",
    "babel-jest": "^30.4.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "3.8.2",
    "sass-embedded": "^1.93.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^6.3.1"
  },
  "dependencies": {
    "@babel/preset-typescript": "^7.24.1",
    "tsx": "^4.16.5"
  }
}
